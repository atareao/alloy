#!/bin/bash
# Pre-commit hook: bloquea commits que toquen código fuente sin un change proposal activo.
#
# Copia canónica y versionada del hook. Instalación (una vez por clon):
#   just install-hooks        # o: git config core.hooksPath .githooks

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || echo '.')"
OPENSPEC_DIR="$ROOT_DIR/openspec"

# --- Helper: ¿Hay change proposals activos? ---
has_active_proposal() {
  ls "$OPENSPEC_DIR/changes/"*/proposal.md 2>/dev/null | head -1
}

# --- Helper: ¿Hay cambios staged en archivos fuente? ---
has_staged_source_changes() {
  git diff --cached --name-only 2>/dev/null | grep -qE '\.(rs|tsx?|jsx?)$'
}

echo -e "${YELLOW}🔍 [PRE-COMMIT] Verificando workflow SDD...${NC}"

# --- Check: ¿Hay cambios source staged sin proposal? ---
if has_staged_source_changes; then
  if ! has_active_proposal >/dev/null 2>&1; then
    echo -e "${RED}❌ [PRE-COMMIT] COMMIT RECHAZADO: Cambios en código fuente sin change proposal activo.${NC}"
    echo -e "${RED}   Sigue el workflow SDD:${NC}"
    echo -e "${RED}   1. Crea un change proposal: openspec change <feature-name>${NC}"
    echo -e "${RED}   2. Completa proposal.md y obtén aprobación del usuario${NC}"
    echo -e "${RED}   3. Recién entonces haz el commit${NC}"
    echo -e ""
    echo -e "${YELLOW}   Para forzar (no recomendado): git commit --no-verify${NC}"
    exit 1
  fi

  # --- Check: ¿Hay proposal sin tareas completadas? ---
  for change_dir in "$OPENSPEC_DIR/changes/"*/; do
    if [ -f "${change_dir}tasks.md" ]; then
      # `grep -c` imprime su conteo y sale con código 1 si no hay coincidencias: con `|| true`
      # se evita el `0` espurio que producía "0\n0"; `${VAR:-0}` cubre el caso sin salida.
      INCOMPLETE=$(grep -c '\[ \]' "${change_dir}tasks.md" 2>/dev/null || true)
      INCOMPLETE=${INCOMPLETE:-0}
      if [ "$INCOMPLETE" -gt 0 ]; then
        echo -e "${YELLOW}⚠️  [PRE-COMMIT] WARNING: Hay $INCOMPLETE tareas sin completar en $(basename "$change_dir")${NC}"
        echo -e "${YELLOW}   Considera completar las tareas antes del commit.${NC}"
      fi
    fi
  done
fi

echo -e "${GREEN}✅ [PRE-COMMIT] Validación superada${NC}"
exit 0
